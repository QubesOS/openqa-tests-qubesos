[templates-itl-testing]
name = Qubes templates-itl testing
baseurl = http://yum.qubes-os.org/r$releasever/templates-itl-testing
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-qubes-$releasever-primary
gpgcheck = 1

[templates-community-testing]
name = Qubes templates-community testing
baseurl = http://yum.qubes-os.org/r$releasever/templates-community-testing
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-qubes-$releasever-templates-community
gpgcheck = 1
